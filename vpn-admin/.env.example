# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string, used to sign sessions and encrypt stored 3x-ui passwords. Do not change after setup.
SECRET_KEY=change-me-to-a-long-random-string

# Port the admin is published on and the interface it binds to
PORT=8080
BIND_ADDR=0.0.0.0

# Optional: domain for automatic HTTPS via Caddy (ports 80/443 must be free)
DOMAIN=
COOKIE_SECURE=false

# Optional: 3x-ui panel to add automatically on first start.
# For 3x-ui v3.0.2+ prefer an API token (Settings → Security → API Token, scope Admin);
# otherwise set username and password.
XUI_URL=
XUI_API_TOKEN=
XUI_USERNAME=
XUI_PASSWORD=
XUI_VERIFY_TLS=true

# Seconds the data from 3x-ui is cached
CACHE_TTL=30
SESSION_HOURS=24

# Where self-updates come from (GitHub repository, branch, project folder)
UPDATE_REPO=obotkov/lexer_space
UPDATE_BRANCH=main
UPDATE_PATH=vpn-admin
